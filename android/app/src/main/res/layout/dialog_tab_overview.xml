<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0C10"
    android:fitsSystemWindows="true">

    <!-- Top Tabs Header with Safe Padding -->
    <LinearLayout
        android:id="@+id/tab_overview_header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#15171E"
        android:elevation="4dp">

        <!-- Back / Close Overview -->
        <ImageButton
            android:id="@+id/btn_close_overview"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Overview"
            android:padding="8dp"
            android:src="@drawable/ic_chrome_back"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Normal vs Private Segmented Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chrome_shortcut"
            android:gravity="center_vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/btn_filter_normal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_tab_pill_active"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Tabs (1)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_filter_private"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_tab_pill_inactive"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Private (0)"
                android:textColor="#9AA0A6"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Close All Action -->
        <TextView
            android:id="@+id/btn_close_all_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:text="Close All"
            android:textColor="#E74C3C"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Content: Tab Cards or Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 2-Column Tabs Grid Container -->
        <ScrollView
            android:id="@+id/tabs_scroll_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <GridLayout
                android:id="@+id/tabs_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:padding="10dp"
                android:useDefaultMargins="true" />
        </ScrollView>

        <!-- Empty Tabs Fallback State -->
        <LinearLayout
            android:id="@+id/empty_tabs_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No Open Tabs"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Open a new tab to browse the web"
                android:textColor="#8A8D93"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_empty_new_tab"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_chrome_sniffer"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="+ Open New Tab"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Action Bar: Prominent New Tab Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#15171E"
        android:elevation="8dp"
        android:gravity="center"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/btn_new_tab_action"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/address_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_tab_plus"
                android:tint="#8AB4F8" />

            <TextView
                android:id="@+id/tv_new_tab_btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="New Tab"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
