<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- 1. Native ExoPlayer View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:use_controller="true" />

    <!-- 2. Web Stream Fallback View -->
    <WebView
        android:id="@+id/playerWebView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. Buffering Indicator -->
    <ProgressBar
        android:id="@+id/playerProgressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:indeterminate="true"
        android:indeterminateTint="#00f2fe"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 4. Gesture Feedback HUD (Brightness & Volume) -->
    <LinearLayout
        android:id="@+id/gestureHudContainer"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="#CC0A1222"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/gestureHudIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_lock_idle_charging"
            app:tint="#00f2fe" />

        <TextView
            android:id="@+id/gestureHudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Volume: 80%"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/gestureHudProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="80"
            android:progressTint="#00f2fe" />
    </LinearLayout>

    <!-- 5. Gesture Seek Time HUD -->
    <LinearLayout
        android:id="@+id/seekHudContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#CC0A1222"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/seekHudDiff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+0:15"
            android:textColor="#00f2fe"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seekHudTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="04:30 / 12:45"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 6. Top Custom Controls Bar -->
    <LinearLayout
        android:id="@+id/playerTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnClosePlayer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Player"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/playerTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSpeed"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="44dp"
            android:paddingHorizontal="6dp"
            android:text="1.0x"
            android:textColor="#00f2fe"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAspectRatio"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="44dp"
            android:paddingHorizontal="6dp"
            android:text="FIT"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnRotateScreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Rotate Screen Orientation"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="#00f2fe" />

        <ImageButton
            android:id="@+id/btnPip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Picture in Picture"
            android:src="@android:drawable/ic_menu_crop"
            app:tint="#00f2fe" />

        <ImageButton
            android:id="@+id/btnLockScreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Lock Screen"
            android:src="@android:drawable/ic_lock_lock"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- 7. Floating Screen Unlock Button (When Locked) -->
    <ImageButton
        android:id="@+id/btnUnlockScreen"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_margin="24dp"
        android:background="#CC0A1222"
        android:contentDescription="Unlock Screen"
        android:src="@android:drawable/ic_lock_idle_lock"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="#00f2fe" />

</androidx.constraintlayout.widget.ConstraintLayout>
