<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_home_feature_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Icon, Title, Version & Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Extension Icon / Badge -->
        <TextView
            android:id="@+id/tv_extension_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_tab_pill_active"
            android:gravity="center"
            android:text="🛡️"
            android:textSize="16sp" />

        <!-- Title & Version Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_extension_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="uBlock Origin Shield"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_extension_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tab_pill_active"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="v1.58.0"
                    android:textColor="#00E5FF"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_extension_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="by gorhill / uBlock Origin"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Delete button (for custom extensions) -->
        <ImageButton
            android:id="@+id/btn_extension_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tab_close"
            android:visibility="gone" />

        <!-- Enabled / Disabled Toggle Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_extension_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Description -->
    <TextView
        android:id="@+id/tv_extension_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="Advanced network request blocker &amp; tracker filter based on EasyList rules."
        android:textColor="#9CA3AF"
        android:textSize="12sp" />
</LinearLayout>
