<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dark"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="#374151" />

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="➕ Add Custom Extension / Script"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="14dp"
        android:text="Inject custom Tampermonkey JS or CSS into web pages."
        android:textColor="#9CA3AF"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Extension Name Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extension Name:"
                android:textColor="#D1D5DB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_ext_name"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_home_search_card"
                android:hint="e.g. My Custom Ad-Blocker or Video Helper"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="13sp" />

            <!-- Description Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description:"
                android:textColor="#D1D5DB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_ext_desc"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_home_search_card"
                android:hint="What does this script do?"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="13sp" />

            <!-- JavaScript Code Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JavaScript Code (Executed on Page Load):"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_ext_js"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_home_search_card"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="// Enter your JavaScript / userscript here&#10;console.log('Running custom extension!');"
                android:padding="10dp"
                android:textColor="#A7F3D0"
                android:textColorHint="#4B5563"
                android:textSize="11sp" />

            <!-- CSS Code Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CSS Style Rules (Optional):"
                android:textColor="#C084FC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_ext_css"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_home_search_card"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="/* Optional CSS */&#10;.banner-ad { display: none !important; }"
                android:padding="10dp"
                android:textColor="#FBCFE8"
                android:textColorHint="#4B5563"
                android:textSize="11sp" />

            <!-- Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_ext_cancel"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_search_card"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_ext_save"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_pill_active"
                    android:text="Save &amp; Enable"
                    android:textAllCaps="false"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
