<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- By default, disallow all unencrypted HTTP cleartext traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Strict exception ONLY for internal on-device loopback (LocalMediaProxy & HLS/torrent decryptor).
         Traffic never leaves device boundary (127.0.0.1). All external traffic strictly requires HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
