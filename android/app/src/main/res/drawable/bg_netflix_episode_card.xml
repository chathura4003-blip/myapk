<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#240084FF" />
            <stroke android:width="1.5dp" android:color="#0084FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#2A1E293B" />
            <stroke android:width="1dp" android:color="#334155" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#141923" />
            <stroke android:width="1dp" android:color="#1F293D" />
        </shape>
    </item>
</selector>
